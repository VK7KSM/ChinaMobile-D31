<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        style="@style/Toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:navigationIcon="@drawable/ic_arrow_back_black_24dp"
        app:title="@string/d31_sip_settings"
        app:titleTextAppearance="@style/ToolbarText" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="640dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <!-- Status Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/d31_search_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <View
                    android:id="@+id/sipStatusDot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/d31_status_dot"
                    android:backgroundTint="#A0ADB3" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <dev.octoshrimpy.quik.common.widget.QkTextView
                        style="@style/TextPrimary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/d31_sip_account_status"
                        android:textStyle="bold" />

                    <dev.octoshrimpy.quik.common.widget.QkTextView
                        android:id="@+id/sipStatus"
                        style="@style/TextSecondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/d31_sip_not_configured_short" />
                </LinearLayout>
            </LinearLayout>

            <!-- Switch -->
            <CheckBox
                android:id="@+id/sipEnabled"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:text="@string/d31_sip_enable"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp" />

            <!-- Server & Port & Transport -->
            <dev.octoshrimpy.quik.common.widget.QkTextView
                style="@style/PreferenceCategory"
                android:layout_marginTop="12dp"
                android:text="服务器连接" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/sipServer"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:background="@drawable/d31_input_background"
                    android:hint="@string/d31_sip_server"
                    android:inputType="textUri"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textColorHint="?android:attr/textColorSecondary"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/sipPort"
                    android:layout_width="110dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/d31_input_background"
                    android:hint="@string/d31_sip_port"
                    android:inputType="number"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textColorHint="?android:attr/textColorSecondary"
                    android:textSize="15sp" />

                <Spinner
                    android:id="@+id/sipTransport"
                    android:layout_width="110dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/d31_input_background" />
            </LinearLayout>

            <!-- Credentials -->
            <dev.octoshrimpy.quik.common.widget.QkTextView
                style="@style/PreferenceCategory"
                android:layout_marginTop="16dp"
                android:text="账户凭据" />

            <EditText
                android:id="@+id/sipUsername"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/d31_input_background"
                android:hint="@string/d31_sip_username"
                android:inputType="text"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="?android:attr/textColorSecondary"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/d31_input_background"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/sipPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/d31_sip_password"
                    android:inputType="textPassword"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textColorHint="?android:attr/textColorSecondary"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/sipPasswordToggle"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="60dp"
                    android:text="@string/d31_show_password"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/sipRealm"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/d31_input_background"
                android:hint="@string/d31_sip_realm"
                android:inputType="text"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="?android:attr/textColorSecondary"
                android:textSize="15sp" />

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/sipCancel"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/d31_cancel"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/sipSave"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/d31_icon_button"
                    android:backgroundTint="#1E88E5"
                    android:minWidth="140dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:text="@string/d31_save_and_connect"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
